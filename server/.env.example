NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://giantpay:giantpay@127.0.0.1:5432/giantpay
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379
TRUSTED_PROXIES=
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=24
RATE_LIMIT_NAMESPACE=giantpay:rate-limit
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_TOLERANCE_SECONDS=300
OUTBOX_WORKER_ENABLED=false
OUTBOX_POLL_MS=1000
SESSION_TTL_HOURS=12
