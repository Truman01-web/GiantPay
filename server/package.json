{
  "name": "giantpay-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=20.19.0 <21 || >=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/run-tests-ci.mjs",
    "verify": "pnpm run typecheck && pnpm run test:ci && pnpm run openapi:validate && pnpm run build && node scripts/check-dist.mjs",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "db:verify-migrations": "tsx src/verifyMigrations.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@apidevtools/swagger-parser": "^10.1.1"
  }
}
