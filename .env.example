# Base URL of the GiantPay backend API (no trailing slash), e.g. https://api.giantpay.mw
VITE_API_URL=http://localhost:4000

VITE_APP_NAME=GiantPay
VITE_APP_ENV=development

# When true, the app is served entirely against MSW mock handlers
# (src/mocks) instead of a real backend. Must never be true in a
# deployed sandbox, staging, or production build — this is enforced in
# src/app/config/env.ts.
VITE_USE_MOCK_API=true

# Deployed sandbox example (the intended URL is not a claim that DNS is live):
# VITE_APP_ENV=sandbox
# VITE_USE_MOCK_API=false
# VITE_API_URL=https://api.giantpay.mw

# Optional. Leave unset unless error monitoring has been explicitly approved.
VITE_SENTRY_DSN=
