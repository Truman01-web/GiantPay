# Base URL of the GiantPay backend API (no trailing slash), e.g. https://api.giantpay.mw
VITE_API_URL=http://localhost:4000
# If checkout is served on a different origin, set this to match the API's FRONTEND_ORIGIN.
# Hosted origins must be HTTPS; local HTTP is restricted to loopback.
# VITE_PUBLIC_CHECKOUT_ORIGIN=http://127.0.0.1:5173

VITE_APP_NAME=GiantPay
VITE_APP_ENV=development

# Use the PostgreSQL-backed local API by default. Set this to true only when
# intentionally developing against the MSW demo fixtures.
VITE_USE_MOCK_API=false
VITE_PORTAL_CONTEXT=merchant

# Deployed sandbox example (the intended URL is not a claim that DNS is live):
# VITE_APP_ENV=sandbox
# VITE_USE_MOCK_API=false
# VITE_PORTAL_CONTEXT=merchant
# VITE_API_URL=https://api.giantpay.mw

# Optional. Leave unset unless error monitoring has been explicitly approved.
VITE_SENTRY_DSN=
